# Copy this file to .env and fill in real values. Never commit .env.
# Placeholders only: nothing in this file is a real credential.

# ---------- Frontend / CORS ----------
# JSON list of frontend origins allowed to call the API (scheme + host + port, no trailing slash).
# 5173 = Vite dev server, 8080 = the Docker (nginx) frontend.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8080","http://127.0.0.1:8080"]

# Address the BROWSER uses to reach the backend. Baked into the frontend at build time.
VITE_API_URL=http://localhost:8000

# ---------- PostgreSQL ----------
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=your_db_name
# Port published on YOUR computer (inside Docker the database always uses 5432)
POSTGRES_PORT=5433

# Used only when the backend runs on your computer (outside Docker).
# Docker Compose overrides it to point at the "db" container.
DATABASE_URL=postgresql+psycopg://your_db_user:your_db_password@localhost:5433/your_db_name

# ---------- OTP ----------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
OTP_SECRET_KEY=change_me_to_a_long_random_string_at_least_32_characters
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ---------- JWT ----------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Use a DIFFERENT key from OTP_SECRET_KEY
JWT_SECRET_KEY=change_me_to_a_different_long_random_string_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---------- Email (Gmail SMTP) ----------
# Requires 2-Step Verification. Create an App Password in your Google Account
# (search "App passwords") and paste it WITHOUT spaces. Never use your real Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your.address@gmail.com
SMTP_PASSWORD=your_16_character_app_password
SMTP_FROM_EMAIL=your.address@gmail.com
SMTP_FROM_NAME=PDF Chat Platform

# ---------- Google Gemini ----------
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key
GEMINI_CHAT_MODEL=gemini-3.8-flash
# Used in order when the chat model is overloaded (Gemini sometimes returns 503 "high demand")
GEMINI_FALLBACK_MODELS=["gemini-3.6-flash","gemini-3.5-flash-lite"]
# The database column is 768-dimensional: only change this with a new migration
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_TEMPERATURE=0.2

# ---------- PDF uploads ----------
MAX_UPLOAD_SIZE_MB=20
MAX_FILES_PER_UPLOAD=10
# Where PDFs are stored when running outside Docker (Docker uses the "uploads" volume)
# UPLOAD_DIR=backend/uploads

# ---------- MCP server ----------
# Streamable HTTP endpoint of the word-definition MCP server.
# Outside Docker: http://localhost:8001/mcp  (Docker Compose uses http://mcp:8001/mcp)
MCP_SERVER_URL=http://localhost:8001/mcp
