# ---------- PostgreSQL ----------
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=your_db_name
POSTGRES_PORT=5432

# ---------- OTP ----------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
OTP_SECRET_KEY=change_me_to_a_long_random_string_at_least_32_characters
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ---------- JWT ----------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Use a DIFFERENT key from OTP_SECRET_KEY
JWT_SECRET_KEY=change_me_to_a_long_random_string_at_least_32_characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

DATABASE_URL=postgresql+psycopg://your_db_user:your_db_password@localhost:5432/your_db_name

# JWT
JWT_SECRET_KEY=your_secret_key
JWT_EXPIRE_MINUTES=30

# Gmail
GMAIL_ADDRESS=your_email@gmail.com
GMAIL_APP_PASSWORD=your_app_password

# LLM
LLM_API_KEY=your_api_key
LLM_MODEL=your_model_name
EMBEDDING_MODEL=your_embedding_model_name

# Frontend
VITE_API_URL=http://localhost:8000

# MCP
MCP_SERVER_URL=http://localhost:8001

# ---------- Email (Gmail SMTP) ----------
# Requires 2-Step Verification. Create an App Password in your Google Account
# (search "App passwords") and paste it WITHOUT spaces. Never use your real Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your.address@gmail.com
SMTP_PASSWORD=your_16_character_app_password
SMTP_FROM_EMAIL=your.address@gmail.com
SMTP_FROM_NAME=PDF Chat Platform